{
  "name": "pixel-office",
  "version": "0.1.0",
  "private": true,
  "description": "8-bit pixel house that shows reels-squad Claude Code agents at work",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "electron .",
    "preview": "node src/main/server-cli.js",
    "demo": "node scripts/demo.js",
    "setup": "node scripts/setup.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@fontsource/vt323": "^5.3.0"
  },
  "author": "KoltaireDinh",
  "build": {
    "appId": "dev.koltairedinh.pixeloffice",
    "productName": "Pixel Office",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "hook/**/*",
      "scripts/setup.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pixel Office"
    },
    "publish": null
  }
}
